From 6423248dc41a5781ae1d0afe255c8fb1072351d1 Mon Sep 17 00:00:00 2001
From: Paul Ganssle <pganssle@google.com>
Date: Thu, 5 Nov 2026 20:12:33 +0300
Subject: [PATCH 2/2] Test that an in-use scalar buffer survives cache eviction
 and that hits allocate nothing

Assisted-by: Claude Fable 5.1
---
 tests/accelerator_api_test.py | 31 ++++++++++++++++++++++++++++---
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/tests/accelerator_api_test.py b/tests/accelerator_api_test.py
index 7c911aa28..8edba19cf 100644
--- a/tests/accelerator_api_test.py
+++ b/tests/accelerator_api_test.py
@@ -710,16 +710,41 @@ class AcceleratorMemoryTest(seed_test_utils.RepeatableTest):
       x = torch.ones(8, device="tpu")
       y = x + 0.25
       # Pass 2048 distinct scalars, twice kMaxCachedScalarBuffers (1024, in
-      # op_dispatcher.cc), so the cache is cleared at least once. Then only the
-      # queued add for y holds its 0.25 buffer.
+      # op_dispatcher.cc), so the cache evicts at least once. The queued add
+      # for y holds its 0.25 buffer, so the eviction keeps that entry.
       for i in range(2048):
         _ = x + (2.0 + i / 4096)
       self.assertFalse(sync.is_materializing(y))
-      # 0.25 now misses the cache, so the graph gets a second 0.25 buffer.
+      # Scalar buffers are allocated when the op is queued, while the deferred
+      # outputs are not. A cache hit therefore allocates nothing and a miss
+      # allocates one buffer.
+      before = torch.accelerator.memory_stats()["allocation.all.current"]
       z = y + 0.25
+      after_hit = torch.accelerator.memory_stats()["allocation.all.current"]
+      w = y + 0.75
+      after_miss = torch.accelerator.memory_stats()["allocation.all.current"]
       torch.accelerator.synchronize()
     utils.assert_close(y.cpu(), torch.full((8,), 1.25))
     utils.assert_close(z.cpu(), torch.full((8,), 1.5))
+    utils.assert_close(w.cpu(), torch.full((8,), 2.0))
+    # The 0.25 buffer that y still uses survived the eviction; 0.75 is new.
+    self.assertLess(after_hit - before, after_miss - after_hit)
+
+  def test_repeated_scalar_reuses_cached_device_buffer(self):
+    with execution_mode.set_eager_mode(EagerMode.DEFER_NEVER):
+      t = torch.ones(8, device="tpu")
+      t = t + 0.5
+      torch.accelerator.synchronize()
+      gc.collect()
+      before = torch.accelerator.memory_stats()["allocation.all.current"]
+      for _ in range(1000):
+        t = t + 0.5
+      torch.accelerator.synchronize()
+      gc.collect()
+      growth = torch.accelerator.memory_stats()["allocation.all.current"] - before
+    utils.assert_close(t.cpu(), torch.full((8,), 501.5))
+    # One cached 0.5 buffer serves every add; only the result tensor is new.
+    self.assertLessEqual(growth, 2)
 
   @parameterized.named_parameters(
       ("top_level", torch.accelerator.get_memory_info),
-- 
